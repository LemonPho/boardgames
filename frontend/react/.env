# Google OAuth client id. Not a secret — it ships in the built bundle and is
# just an audience label; the backend verifies tokens against Google's public
# keys and checks this same id as the audience. Must match
# google.oauth.client-id in the backend's application-{dev,prod}.properties.
VITE_GOOGLE_CLIENT_ID=471546944671-8rvlp7dhlrk0t71c9dkv395aliork59s.apps.googleusercontent.com
